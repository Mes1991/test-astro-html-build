---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import { t } from "../../i18n/t";
import { pathFor } from "../../lib/seo/locale";
import type { LocaleCode } from "../../lib/seo/types";
import { DEFAULT_LOCALE } from "../../lib/seo/types";

interface Props {
	locale?: LocaleCode;
}

const { locale = DEFAULT_LOCALE } = Astro.props;

/**
 * 2-column blog teaser component.
 *   posts[0] → featured card on the left (image + author meta + title + desc + footer)
 *   posts[1..3] → list items on the right (meta + title + tag chips + thumbnail)
 */
const all = (await getCollection("blog", (e) => !e.data.draft)).sort(
	(a, b) =>
		new Date(b.data.datePublished).getTime() -
		new Date(a.data.datePublished).getTime(),
);
const featured = all[0];
const list = all.slice(1, 4);

const blogHref = pathFor("blog", locale);
const postHref = (slug: string) =>
	locale === "es" ? `/es/blog/${slug}` : `/blog/${slug}`;

type Entry = (typeof all)[number];
function fields(entry: Entry) {
	const es = entry.data.translations?.es;
	return {
		title: locale === "es" && es?.title ? es.title : entry.data.title,
		description:
			locale === "es" && es?.description
				? es.description
				: entry.data.description,
		category:
			locale === "es" && es?.category ? es.category : entry.data.category,
		imageAlt:
			locale === "es" && es?.imageAlt ? es.imageAlt : entry.data.imageAlt,
		image: entry.data.image,
		slug: entry.data.slug,
		author: entry.data.author,
		date: entry.data.datePublished,
		keywords: entry.data.keywords ?? [],
	};
}

const dateFormatter = new Intl.DateTimeFormat(
	locale === "es" ? "es-MX" : "en-US",
	{ day: "numeric", month: "short", year: "numeric" },
);
const fmtDate = (iso: string | Date) =>
	dateFormatter.format(new Date(iso)).replace(/\.$/, "");

const badge = t("home.blog.badge", locale);
const titleA = t("home.blog.titleA", locale);
const titleB = t("home.blog.titleB", locale);
const lede = t("home.blog.lede", locale);
const cta = t("home.blog.viewAll", locale);
const readMore = t("home.blog.cardCta", locale);
const studioRole = locale === "es" ? "Estudio" : "Studio";
---

{featured && (
  <section
    id="blog-content"
    data-mood="curious"
    class="px-6 lg:px-8 pt-0 lg:pt-12 py-24"
  >
    <div class="mx-auto max-w-7xl">
    {/* Header */}
    <div class="mb-12 text-center sm:mb-16 lg:mb-20 max-w-[680px] mx-auto">
      <span class="blog-eyebrow inline-block bg-brand-cream border border-brand-surface-dark/15 rounded-full px-4 py-[6px] font-mono text-[11px] tracking-caps-3 uppercase text-brand-surface-dark mb-5">
        {badge}
      </span>
      <h2 class="blog-title font-display font-black text-display-sm leading-[0.95] tracking-display-3 text-brand-surface-dark mb-4">
        {titleA}{" "}<em class="not-italic text-brand-primary">{titleB}</em>
      </h2>
      <p class="blog-lede text-[17px] leading-[1.55] text-ui-700">
        {lede}
      </p>
    </div>

    <div class="grid grid-cols-1 gap-10 lg:grid-cols-2 lg:items-center">

      {/* Featured card (left) */}
      {(() => {
        const p = fields(featured);
        return (
          <div class="bento-cell blog-card flex flex-col gap-6 rounded-xl border border-brand-surface-dark/10 bg-brand-cream-warm py-6 shadow-none group">
            <a href={postHref(p.slug)} class="px-6 block no-underline">
              <Image
                src={p.image}
                alt={p.imageAlt}
                widths={[480, 720, 960, 1280]}
                sizes="(min-width: 64rem) 600px, 100vw"
                format="webp"
                loading="lazy"
                class="max-h-[19rem] w-full rounded-lg object-cover transition-transform duration-700 ease-[cubic-bezier(0.86,0,0.07,1)] group-hover:scale-[1.01]"
              />
            </a>
            <div class="grid auto-rows-min grid-rows-[auto_auto] items-start px-6 gap-3">
              <div class="flex items-center gap-2 py-1 text-sm">
                <span class="text-base font-semibold text-brand-surface-dark">{p.author}</span>
                <span class="text-ui-600">{fmtDate(p.date)}</span>
              </div>
              <a href={postHref(p.slug)} class="no-underline">
                <h3 class="text-3xl font-medium font-display text-brand-surface-dark hover:text-brand-primary transition-colors">
                  {p.title}
                </h3>
              </a>
              <p class="text-ui-700 line-clamp-3 text-base">
                {p.description}{" "}
                <a href={postHref(p.slug)} class="text-brand-primary inline text-sm font-medium hover:underline">
                  {readMore}
                </a>
              </p>
            </div>
            <div class="flex items-center px-6">
              <a href={blogHref} class="flex items-center gap-2 no-underline">
                <span class="relative flex size-8 shrink-0 overflow-hidden rounded-full bg-brand-highlight">
                  <img
                    src="/assets/logo-mark.svg"
                    alt=""
                    width="32"
                    height="32"
                    class="aspect-square size-8 rounded-full object-cover"
                    loading="lazy"
                  />
                </span>
                <div class="flex flex-col leading-tight">
                  <span class="font-medium text-brand-surface-dark text-sm">{p.author}</span>
                  <span class="text-ui-600 text-xs">{studioRole}</span>
                </div>
              </a>
            </div>
          </div>
        );
      })()}

      {/* List (right) */}
      <div class="space-y-10">
        {list.map((entry, i) => {
          const p = fields(entry);
          const tags = p.keywords.slice(0, 2);
          return (
            <div class="space-y-10">
              <a
                href={postHref(p.slug)}
                class="bento-cell blog-card flex items-center justify-between gap-6 max-sm:flex-wrap no-underline group"
              >
                <div class="min-w-0 flex-1">
                  <div class="mb-1.5 flex items-center gap-2 py-1 text-sm">
                    <span class="font-medium text-brand-surface-dark">{p.author}</span>
                    <span class="text-ui-600">{fmtDate(p.date)}</span>
                  </div>
                  <h3 class="mb-5 text-xl font-medium font-display text-brand-surface-dark group-hover:text-brand-primary transition-colors">
                    {p.title}
                  </h3>
                  <div class="flex flex-wrap gap-2">
                    {tags.length > 0 ? (
                      tags.map((tag) => (
                        <span class="inline-flex w-fit shrink-0 items-center justify-center rounded-full border border-brand-surface-dark/20 px-2 py-0.5 text-xs font-medium whitespace-nowrap text-brand-surface-dark">
                          {tag}
                        </span>
                      ))
                    ) : (
                      p.category && (
                        <span class="inline-flex w-fit shrink-0 items-center justify-center rounded-full border border-brand-surface-dark/20 px-2 py-0.5 text-xs font-medium whitespace-nowrap text-brand-surface-dark">
                          {p.category}
                        </span>
                      )
                    )}
                  </div>
                </div>
                <Image
                  src={p.image}
                  alt={p.imageAlt}
                  widths={[200, 400]}
                  sizes="168px"
                  format="webp"
                  loading="lazy"
                  class="h-[152px] w-[168px] shrink-0 rounded-lg object-cover transition-transform duration-700 ease-[cubic-bezier(0.86,0,0.07,1)] group-hover:scale-[1.02]"
                />
              </a>
              {i < list.length - 1 && (
                <div class="h-px w-full bg-brand-surface-dark/10"></div>
              )}
            </div>
          );
        })}
      </div>
    </div>

    {/* CTA */}
    <div class="mt-12 text-center sm:mt-16 lg:mt-20">
      <a
        href={blogHref}
        class="blog-card inline-flex shrink-0 items-center justify-center gap-2 font-medium whitespace-nowrap bg-brand-primary text-brand-cream hover:bg-brand-highlight hover:text-brand-ink h-10 px-6 rounded-lg text-base no-underline transition-colors"
      >
        {cta}
      </a>
    </div>
    </div>
  </section>
)}

<script>
  import gsap from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  gsap.registerPlugin(ScrollTrigger);

  const root = document.querySelector<HTMLElement>("#blog-content");
  const zone = document.querySelector<HTMLElement>("#paper-cream-zone");
  const blogSection = document.querySelector<HTMLElement>("#blog");
  if (zone && blogSection) {
    const styles = getComputedStyle(document.documentElement);
    const paper =
      styles.getPropertyValue("--color-brand-paper").trim() || "#ffffff";
    const cream =
      styles.getPropertyValue("--color-brand-cream-warm").trim() || "#e5e7eb";
    gsap.fromTo(
      zone,
      { backgroundColor: paper },
      {
        backgroundColor: cream,
        ease: "none",
        scrollTrigger: {
          trigger: blogSection,
          start: "top-=20% center",
          end: "top+=20% center",
          scrub: true,
          markers: false,
        },
      },
    );
  }

  if (root) {
    const eyebrowEl = root.querySelector<HTMLElement>(".blog-eyebrow");
    const titleEl = root.querySelector<HTMLElement>(".blog-title");
    const ledeEl = root.querySelector<HTMLElement>(".blog-lede");
    const cards = root.querySelectorAll<HTMLElement>(".bento-cell");

    const heads = [eyebrowEl, titleEl, ledeEl].filter(
      (el): el is HTMLElement => !!el,
    );
    if (heads.length) {
      gsap.set(heads, { opacity: 0, y: 28 });
      gsap.to(heads, {
        opacity: 1,
        y: 0,
        duration: 0.9,
        ease: "power3.out",
        stagger: 0.08,
        scrollTrigger: { trigger: root, start: "top 80%", once: true },
      });
    }

    if (cards.length) {
      gsap.set(cards, { opacity: 0, y: 32 });
      gsap.to(cards, {
        opacity: 1,
        y: 0,
        duration: 1,
        ease: "power3.out",
        stagger: 0.08,
        scrollTrigger: { trigger: cards[0], start: "top 85%", once: true },
      });
    }
  }
</script>
