---
import "../styles/global.css";
import Hero3D from "../components/coming-soon/Hero3D.astro";
import AvatarCycler from "../components/coming-soon/AvatarCycler.astro";
import { absoluteUrl, routeUrl } from "../lib/seo/url";
import { siteSeo } from "../lib/seo/defaults";

const title = "Coming soon — a new site built with this template";
const description =
  "Something great is on the way. This site is being built with this template and will launch shortly — please check back soon.";
const ogImage = absoluteUrl("/og/default.png");
const canonicalHref = routeUrl("/coming-soon/");

/* Holding pages are explicit sitemap/index opt-outs in every locale. Replace
   this directive only when this route becomes real launch content. */
const robots = "noindex,follow";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content={robots} />
    <meta name="sitemap" content="exclude" />
    <meta name="theme-color" content="#0b1220" />
    <title>{title}</title>
    <meta name="description" content={description} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />


    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="canonical" href={canonicalHref} />
  </head>
  <body class="cs-body">
    <main class="cs-stage">
      <Hero3D />

      <div class="cs-overlay">
        <p class="cs-eyebrow"><span class="cs-rule"></span> EXAMPLE SITE</p>
        <h1 class="cs-tagline">
          building<br />
          something <span class="cs-accent">great<span class="cs-dot">.</span></span><br />
          back <em>soon<span class="cs-dot">.</span></em>
        </h1>
        <a class="cs-email" href={`mailto:${siteSeo.organization.email}`}>{siteSeo.organization.email}</a>
      </div>

      <AvatarCycler />
    </main>

    <style is:global>
      html,
      body {
        height: 100%;
        margin: 0;
        overflow: hidden;
        color: var(--color-brand-cream);
      }
      body {
        /* Mirror the home Services dark backdrop so the holding page
           lives in the same world as the rest of the site. */
        background: var(--color-brand-surface-deep);
        background-image:
          radial-gradient(ellipse at 15% 0%, rgba(30, 41, 59, 0.7) 0%, transparent 55%),
          radial-gradient(ellipse at 85% 100%, rgba(59, 130, 246, 0.12) 0%, transparent 55%),
          linear-gradient(var(--color-brand-surface-deep), var(--color-brand-surface-deep));
      }
    </style>

    <style>
      .cs-stage {
        position: relative;
        width: 100vw;
        height: 100vh;
        height: 100dvh;
        overflow: hidden;
      }
      .cs-overlay {
        position: relative;
        z-index: 2;
        width: 100%;
        height: 100%;
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        justify-content: center;
        gap: 28px;
        padding: 0 8vw;
        box-sizing: border-box;
        text-align: left;
        pointer-events: none;
      }
      .cs-overlay > * {
        pointer-events: auto;
      }
      .cs-eyebrow {
        margin: 0;
        font-family: "JetBrains Mono Variable", ui-monospace, monospace;
        font-size: 12px;
        letter-spacing: 0.18em;
        text-transform: uppercase;
        color: var(--color-brand-highlight);
        display: inline-flex;
        align-items: center;
        gap: 14px;
      }
      .cs-rule {
        display: inline-block;
        width: 36px;
        height: 1px;
        background: var(--color-brand-highlight);
      }
      .cs-tagline {
        margin: 0;
        font-family: var(--font-display);
        font-weight: 900;
        font-size: clamp(48px, 9vw, 124px);
        line-height: 0.98;
        letter-spacing: var(--tracking-display-3);
        color: var(--color-brand-cream);
        max-width: 18ch;
      }
      .cs-tagline em {
        font-style: normal;
        color: var(--color-brand-primary-light);
      }
      .cs-accent {
        color: var(--color-brand-highlight);
      }
      .cs-dot {
        color: var(--color-brand-primary-light);
      }
      .cs-email {
        font-family: "JetBrains Mono Variable", ui-monospace, monospace;
        font-size: 13px;
        letter-spacing: 0.04em;
        color: rgba(243, 244, 246, 0.65);
        text-decoration: none;
        transition: color 0.15s ease;
        margin-top: 10px;
      }
      .cs-email:hover {
        color: var(--color-brand-highlight);
      }

      @media (max-width: 640px) {
        .cs-overlay {
          padding: 0 28px;
          gap: 22px;
        }
        .cs-eyebrow {
          font-size: 11px;
        }
      }
    </style>
  </body>
</html>
