---
import { getCollection, render } from "astro:content";
import { Image } from "astro:assets";
import BaseLayout from "../../layouts/BaseLayout.astro";
import SiteHeader from "../../components/shared/SiteHeader.astro";
import Footer from "../../components/home/Footer.astro";
import BreadcrumbsJsonLd from "../../components/seo/BreadcrumbsJsonLd.astro";
import { buildBlogPosting } from "../../lib/seo/schemas/article";
import { routeUrl } from "../../lib/seo/url";
import { readingTime } from "../../lib/blog/reading-time";
import NextRead from "../../components/blog/NextRead.astro";

export async function getStaticPaths() {
  const all = await getCollection("blog", (e) => !e.data.draft);
  return all.map((entry) => ({
    params: { slug: entry.data.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { data } = entry;
const { Content } = await render(entry);
const minutes = readingTime(entry.body ?? "");

const locale = "en";
const title = data.seo?.title ?? data.title;
const description = data.seo?.description ?? data.description;

const explicitAlternates = {
  en: routeUrl(`/blog/${data.slug}`),
  es: routeUrl(`/es/blog/${data.slug}`),
  "x-default": routeUrl(`/blog/${data.slug}`),
};

const articleSchema = buildBlogPosting({
  headline: data.title,
  description: data.description,
  slug: data.slug,
  imageUrl: typeof data.image === "string" ? data.image : data.image.src,
  datePublished: data.datePublished,
  dateModified: data.dateModified,
  authorName: data.author,
  section: data.category,
  keywords: data.keywords,
  locale,
  pageUrl: routeUrl(`/blog/${data.slug}`),
});
---

<BaseLayout
  title={title}
  description={description}
  locale={locale}
  type="article"
  alternates={explicitAlternates}
  publishedTime={data.datePublished}
  modifiedTime={data.dateModified}
  author={data.author}
  schema={articleSchema}
  noindex={!data.sitemap}
  image={{ src: typeof data.image === "string" ? data.image : data.image.src, alt: data.imageAlt }}
>
  <Fragment slot="head">
    <BreadcrumbsJsonLd
      crumbs={[
        { name: "Home", url: routeUrl("/") },
        { name: "Blog", url: routeUrl("/blog") },
        { name: data.title, url: routeUrl(`/blog/${data.slug}`) },
      ]}
    />
  </Fragment>
  <main id="main" class="bg-brand-cream-warm min-h-screen">
    <SiteHeader locale="en" />
    <article class="mx-auto max-w-[760px] px-12 py-20 max-lgx:px-6 max-lgx:py-12">
      <header class="mb-12 max-lgx:mb-8">
        <div class="font-mono text-[11px] tracking-caps-3 uppercase text-brand-primary mb-4">
          {new Date(data.datePublished).toISOString().slice(0, 10)}
          {data.category && <> · {data.category}</>}
          <> · {minutes} min read</>
        </div>
        <h1 class="font-display font-black text-display-md leading-[0.95] tracking-display-3 text-brand-surface-dark">
          {data.title}
        </h1>
        <p class="mt-5 text-[18px] leading-[1.55] text-ui-700 max-w-[640px]">
          {data.description}
        </p>
      </header>
      <div class="aspect-[16/9] overflow-hidden rounded-card bg-brand-surface-dark/5 mb-12">
        <Image
          src={data.image}
          alt={data.imageAlt}
          widths={[640, 960, 1280, 1600]}
          sizes="(min-width: 60rem) 760px, 100vw"
          format="webp"
          class="w-full h-full object-cover"
        />
      </div>
      <div class="prose-blog text-[17px] leading-[1.7] text-brand-surface-dark/85">
        <Content />
      </div>
    </article>
    <NextRead current={entry} locale="en" />
    <Footer locale="en" />
  </main>
</BaseLayout>

<style is:global>
  .prose-blog h2 {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.6rem;
    line-height: 1.2;
    margin: 2.6rem 0 0.9rem;
    color: var(--color-brand-surface-dark);
  }
  .prose-blog h3 {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.2rem;
    margin: 2rem 0 0.75rem;
    color: var(--color-brand-surface-dark);
  }
  .prose-blog p {
    margin: 0 0 1.1rem;
  }
  .prose-blog ul,
  .prose-blog ol {
    margin: 0 0 1.1rem 1.4rem;
  }
  .prose-blog li {
    margin: 0.35rem 0;
  }
  .prose-blog a {
    color: var(--color-brand-primary);
    text-underline-offset: 3px;
  }
  .prose-blog strong {
    color: var(--color-brand-surface-dark);
    font-weight: 700;
  }
</style>
