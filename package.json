    "@astrojs/react": "^6.0.1",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.3",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.0",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/vite": "^4.2.2",
    "@types/three": "^0.184.0",
    "astro": "^7.1.3",
    "gradflow": "^0.1.0",
    "gsap": "^3.15.0",
    "lenis": "^1.3.23",
    "parse5": "^7.3.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "satori": "^0.26.0",
    "schema-dts": "^2.0.0",
    "tailwindcss": "^4.2.2",
    "three": "^0.184.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
