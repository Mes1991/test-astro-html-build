{
  "name": "test-astro-html-build",
  "description": "Agent-ready Astro static site template",
  "type": "module",
  "version": "0.1.0",
  "packageManager": "bun@1.2.13",
  "engines": {
    "node": ">=22.12.0",
    "bun": ">=1.2.13"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
